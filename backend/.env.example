# Groq (required for the Strands specialist agents)
GROQ_API_KEY=
# Production Groq free/developer model with tool use.
# llama-3.3-70b-versatile is now enterprise-only.
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional local fallback. Leave MODEL_PROVIDER=groq unless you run Ollama.
MODEL_PROVIDER=groq
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Application
DATABASE_PATH=sentinel.db
REQUEST_TIMEOUT_SECONDS=15
ENABLE_BROWSER_FALLBACK=true
BROWSER_TIMEOUT_SECONDS=20
MIN_READABLE_CHARS=80

# WhatsApp Cloud API (optional). The system runs without these.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RECIPIENT_PHONE=
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v21.0
NOTIFICATION_CHANNEL=whatsapp

# Public URLs. Do not leave these as localhost in a deployed environment.
# Local example:
#   PUBLIC_BASE_URL=http://127.0.0.1:8000
#   FRONTEND_URL=http://localhost:5173
#   CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Deployed example:
#   PUBLIC_BASE_URL=https://api.your-domain.example
#   FRONTEND_URL=https://app.your-domain.example
#   CORS_ORIGINS=https://app.your-domain.example
PUBLIC_BASE_URL=
FRONTEND_URL=
CORS_ORIGINS=
SESSION_SECRET=

# Gmail OAuth (optional until you connect Gmail).
# Register GOOGLE_REDIRECT_URI in Google Cloud exactly as configured here.
# Local example:
#   GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/integrations/gmail/callback
#   GMAIL_WEBHOOK_URL=https://YOUR_TUNNEL/api/webhooks/gmail?token=long-random-string
# Deployed example:
#   GOOGLE_REDIRECT_URI=https://api.your-domain.example/api/integrations/gmail/callback
#   GMAIL_WEBHOOK_URL=https://api.your-domain.example/api/webhooks/gmail?token=long-random-string
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_PUBSUB_TOPIC=
GOOGLE_PUBSUB_VERIFICATION_TOKEN=
GOOGLE_TOKEN_ENCRYPTION_KEY=
GMAIL_WEBHOOK_URL=
# Enable POST /api/integrations/gmail/dev/ingest for local testing without Pub/Sub.
GMAIL_DEV_INGEST=false
